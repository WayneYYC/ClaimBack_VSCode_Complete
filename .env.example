# ClaimBack will run in Demo mode even when these are blank.
# Real sponsor integration needs this Nicrron API key.
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto
NICRRON_TIMEOUT_SECONDS=45

# Optional PRISM tracing. Add BOTH key and Project UUID for live trace + span uploads.
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
